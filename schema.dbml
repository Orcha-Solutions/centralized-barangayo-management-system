}

Table InstitutionMinutes {
  id String [pk, default: `cuid()`]
  institutionId String
  meetingAt DateTime
  agenda String
  minutes String
  fileUrl String
}

Table Budget {
  id String [pk, default: `cuid()`]
  barangayId String
  year Int
  ordinanceId String
  totalAmount Decimal
  skFundAmount Decimal [default: 0]
  status String [default: 'draft']
  createdAt DateTime [default: `now()`]
}

Table BudgetLine {
  id String [pk, default: `cuid()`]
  budgetId String
  expenseClass String
