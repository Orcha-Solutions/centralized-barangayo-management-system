  status BatchStatus [default: 'draft']
  preparedById String
  approvedById String
  approvedAt DateTime
  executedAt DateTime
  totalCentavos BigInt [default: 0]
  itemCount Int [default: 0]
  sourceNote String
  disasterEventId String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

enum BatchItemStatus {
  pending
  paid
  failed
  otc_fallback // no wallet / declined digital — pay over the counter
  cancelled
}

Table DisbursementBatchItem {
  id String [pk, default: `cuid()`]
  batchId String
  inhabitantId String
  walletId String
  payeeName String
  amountCentavos BigInt
  status BatchItemStatus [default: 'pending']
  remarks String
