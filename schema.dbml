enum ConcernStatus {
  submitted
  acknowledged
  in_progress
  resolved
  rejected
}

Table Concern {
  id String [pk, default: `cuid()`]
  barangayId String
  inhabitantId String
  referenceNo String [unique]
  category String
  description String
  photoUrl String
  resolutionPhotoUrl String
  latitude Float
  longitude Float
  purok String
  status ConcernStatus [default: 'submitted']
  source RecordSource [default: 'CBMS']
  messengerThreadId String
  slaDueAt DateTime
  acknowledgedAt DateTime
  resolvedAt DateTime
  assignedToId String
  resolutionNote String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

enum SosStatus {
  active
  acknowledged
  dispatched
  resolved
  false_alarm
  test
}

Table SosAlert {
  id String [pk, default: `cuid()`]
  barangayId String
  inhabitantId String
  kind String
  latitude Float
  longitude Float
  note String
  status SosStatus [default: 'active']
  isTest Boolean [default: false]
  acknowledgedAt DateTime
  respondedById String
  resolvedAt DateTime
  responseNote String
  createdAt DateTime [default: `now()`]
}

Table Announcement {
  id String [pk, default: `cuid()`]
  barangayId String
  title String
  body String
  category String [default: 'general']
  severity String [default: 'info']
  channels String[] [default: '["in_app"]']
  publishedAt DateTime
  isPublished Boolean [default: false]
  disasterEventId String
  authorId String
  createdAt DateTime [default: `now()`]
}

Table AnnouncementReply {
  id String [pk, default: `cuid()`]
  announcementId String
  inhabitantId String
  body String
  isModerated Boolean [default: false]
  isHidden Boolean [default: false]
  createdAt DateTime [default: `now()`]
}

enum AppointmentStatus {
  booked
  checked_in
  serving
  completed
  no_show
  cancelled
}

Table Appointment {
  id String [pk, default: `cuid()`]
  barangayId String
  inhabitantId String
  service String
  scheduledAt DateTime
  queueNumber String
  status AppointmentStatus [default: 'booked']
  checkedInAt DateTime
  servedAt DateTime
  completedAt DateTime
  notes String
  createdAt DateTime [default: `now()`]
}

Table Feedback {
  id String [pk, default: `cuid()`]
  barangayId String
  inhabitantId String
  rating Int
  comment String
  service String
  certificateRequestId String
  concernId String
  isGrievance Boolean [default: false]
  escalatedAt DateTime
  createdAt DateTime [default: `now()`]
}

Table DigitalId {
  id String [pk, default: `cuid()`]
  inhabitantId String [unique]
  idNumber String [unique]
  qrCode String [unique]
  issuedAt DateTime [default: `now()`]
  expiresAt DateTime
  isRevoked Boolean [default: false]
  photoUrl String
}

Table HealthCampaign {
  id String [pk, default: `cuid()`]
  barangayId String
  name String
  kind String
  cohortFilter Json
  startsAt DateTime
  endsAt DateTime
  isActive Boolean [default: true]
  createdAt DateTime [default: `now()`]
}

Table HealthRecord {
  id String [pk, default: `cuid()`]
  campaignId String
  inhabitantId String
  kind String
  notes String
  recordedAt DateTime [default: `now()`]
  recordedById String
  followUpAt DateTime
}

Table JobPost {
  id String [pk, default: `cuid()`]
  barangayId String
  title String
  employer String
  kind String [default: 'job']
  description String
  location String
  salaryRange String
  contact String
  closesAt DateTime
  isActive Boolean [default: true]
  createdAt DateTime [default: `now()`]
}

Table JobApplication {
  id String [pk, default: `cuid()`]
  jobPostId String
  inhabitantId String
  status String [default: 'submitted']
  note String
  createdAt DateTime [default: `now()`]
}

Table BenefitApplication {
  id String [pk, default: `cuid()`]
  barangayId String
  inhabitantId String
  program String
  status String [default: 'submitted']
  documents String[] [default: '[]']
  reviewedById String
  reviewNote String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table PbCycle {
  id String [pk, default: `cuid()`]
  barangayId String
  title String
  year Int
  opensAt DateTime
  closesAt DateTime
  status String [default: 'open']
  createdAt DateTime [default: `now()`]
}

Table PbOption {
  id String [pk, default: `cuid()`]
  cycleId String
  projectId String
  label String
  detail String
  voteCount Int [default: 0]
}

Table PbVote {
  id String [pk, default: `cuid()`]
  cycleId String
  optionId String
  inhabitantId String
  createdAt DateTime [default: `now()`]
}

enum LguDocType {
  business_permit
  building_permit
  zoning_clearance
  rpt_clearance
  sanitary_permit
}

enum LguDocStatus {
  pending
  under_review
  approved
  rejected
  released
}

enum CivilRegistryType {
  birth
  marriage
  death
}

enum RptPropertyType {
  residential
  commercial
  industrial
  agricultural
  special
}

enum RptPaymentStatus {
  unpaid
  partially_paid
  fully_paid
  exempt
}

Table DrrmResource {
  id String [pk, default: `cuid()`]
  barangayId String
  name String
  type String
  quantity Int [default: 0]
  status String [default: 'operational']
  notes String
  isActive Boolean [default: true]
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table LguDocRequest {
  id String [pk, default: `cuid()`]
  barangayId String
  inhabitantId String
  docType LguDocType
  purpose String
  status LguDocStatus [default: 'pending']
  referenceNo String [unique]
  fee Decimal [default: 0.0]
  paidAt DateTime
  orNumber String
  remarks String
  attachmentName String
  attachmentUrl String
  source RecordSource [default: 'CBMS']
  approvedAt DateTime
  releasedAt DateTime
  isActive Boolean [default: true]
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table CivilRegistryRecord {
  id String [pk, default: `cuid()`]
  barangayId String
  recordType CivilRegistryType
  registryNo String [unique]
  registeredAt DateTime
  inhabitantId String
  childName String
  fatherName String
  motherName String
  dateOfBirth DateTime
  placeOfBirth String
  groomName String
  brideName String
  dateOfMarriage DateTime
  placeOfMarriage String
  deceasedName String
  dateOfDeath DateTime
  causeOfDeath String
  placeOfDeath String
  remarks String
  isActive Boolean [default: true]
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table RptProperty {
  id String [pk, default: `cuid()`]
  barangayId String
  taxDeclarationNo String [unique]
  ownerInhabitantId String
  ownerName String
  propertyType RptPropertyType
  assessedValue Decimal
  marketValue Decimal
  addressLine String
  purok String
  isActive Boolean [default: true]
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table RptTaxDue {
  id String [pk, default: `cuid()`]
  rptPropertyId String
  taxYear Int
  basicTaxAmount Decimal
  sefTaxAmount Decimal
  penaltyAmount Decimal [default: 0.0]
  totalAmount Decimal
  paymentStatus RptPaymentStatus [default: 'unpaid']
  paidAt DateTime
  orNumber String
  isActive Boolean [default: true]
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table Assembly {
  id String [pk, default: `cuid()`]
  barangayId String
  title String
  scheduledAt DateTime
  agenda String
  minutes String
  isPublished Boolean [default: false]
  createdAt DateTime [default: `now()`]
}

// ============================================================================
// Omnichannel Messaging & Meta Messenger Integration
// ============================================================================

enum ChannelType {
  messenger
  sms
  web_chat
  kiosk
  whatsapp
  email
}

enum ConversationStatus {
  bot_active
  desk_assigned
  resolved
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageSenderType {
  inhabitant
  bot
  desk_officer
  system
}

Table ConversationThread {
  id String [pk, default: `cuid()`]
  barangayId String
  inhabitantId String
  channel ChannelType [default: 'messenger']
  externalSenderId String // e.g. Facebook PSID (Page-Scoped ID) or Phone Number
  senderName String
  senderPhone String
  status ConversationStatus [default: 'bot_active']
  assignedOfficerId String
  lastMessageAt DateTime [default: `now()`]
  lastIntent String
  contextData Json // Session state for guided intake wizards (blotter, clearance)
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table ChatMessage {
  id String [pk, default: `cuid()`]
  threadId String
  direction MessageDirection
  senderType MessageSenderType
  senderUserId String
  content String
  mediaUrls String[] [default: '[]']
  rawPayload Json
  isRead Boolean [default: false]
  sentAt DateTime [default: `now()`]
}

Table MessengerPageConfig {
  id String [pk, default: `cuid()`]
  barangayId String [unique]
  pageId String [unique]
  pageName String
  pageAccessToken String // Encrypted
  verifyToken String
  appSecret String // Encrypted
  greetingMessage String
  isBotEnabled Boolean [default: true]
  autoOfficeHours Json
  isActive Boolean [default: true]
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}


