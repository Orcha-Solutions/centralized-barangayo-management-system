  priority String [default: 'normal']
  raisedById String
  assignedToId String
  resolvedAt DateTime
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table TicketResponse {
  id String [pk, default: `cuid()`]
  ticketId String
  authorId String
  body String
  isInternal Boolean [default: false]
  createdAt DateTime [default: `now()`]
}

Table FileObject {
  id String [pk, default: `cuid()`]
  barangayId String
