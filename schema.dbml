enum TenantMode {
  companion // LGUSS-BIMS is system of record; CBMS reads/annotates
  standalone // CBMS records authoritative (pilots/demos)
}

enum RecordSource {
  CBMS
  BIMS
  IMPORT
  MESSENGER
  KIOSK
  DESK
  ONLINE
  PWA
}

Table Tenant {
  id String [pk, default: `cuid()`]
  name String
  subdomain String [unique]
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table Region {
  id String [pk, default: `cuid()`]
  psgcCode String [unique]
  name String
  createdAt DateTime [default: `now()`]
}

Table Province {
  id String [pk, default: `cuid()`]
  psgcCode String [unique]
  name String
  regionId String
}

Table City {
  id String [pk, default: `cuid()`]
  psgcCode String [unique]
  name String
  isCity Boolean [default: true]
  provinceId String
}

enum BarangayStatus {
  pending // registered, awaiting LGU admin approval (MC 2025-104 §4.2.1)
  active
  suspended
}

Table Barangay {
  id String [pk, default: `cuid()`]
  tenantId String
  psgcCode String [unique]
  name String
  cityId String
  status BarangayStatus [default: 'pending']
  mode TenantMode [default: 'companion']
  logoUrl String
  brandPrimary String [default: '#0A2463']
  brandAccent String [default: '#FDB913']
  addressLine String
  contactPhone String
  contactEmail String
  hotline String
  puroks String[] [default: '[]']
  approvedAt DateTime
  approvedById String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

enum RoleKey {
  SYSTEM_ADMIN
  LGU_ADMIN
  PUNONG_BARANGAY
  BARANGAY_SECRETARY
  BARANGAY_TREASURER
  SB_MEMBER
  SK_OFFICIAL
  LUPON_SECRETARY
  VAW_DESK_OFFICER
  BHW
  TANOD
  RESIDENT
  AGENT_MERCHANT
  DILG_VIEWER
}

enum ScopeLevel {
  platform
  region
  province
  city
  barangay
  self
}

Table Role {
  id String [pk, default: `cuid()`]
  key RoleKey [unique]
  name String
  description String
  scope ScopeLevel
  isStaff Boolean [default: true]
}

Table Permission {
  id String [pk, default: `cuid()`]
  key String [unique]
  module String
  action String
}

Table RolePermission {
  roleId String
  permissionId String
}

Table User {
  id String [pk, default: `cuid()`]
  name String
  email String [unique]
  emailVerified Boolean [default: false]
  image String
  phone String [unique]
  passwordHash String
  fullName String
  avatarUrl String
  isActive Boolean [default: true]
  mfaEnabled Boolean [default: false]
  mfaSecret String
  barangayId String
  cityId String
  inhabitantId String [unique]
  lastLoginAt DateTime
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table UserRole {
  userId String
  roleId String
}

Table Session {
  id String [pk, default: `cuid()`]
  userId String
  token String [unique]
  expiresAt DateTime
  ipAddress String
  userAgent String
  mfaPassed Boolean [default: false]
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table Account {
  id String [pk, default: `cuid()`]
  userId String
  accountId String
  providerId String
  accessToken String
  refreshToken String
  accessTokenExpiresAt DateTime
  refreshTokenExpiresAt DateTime
  scope String
  idToken String
  password String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table Verification {
  id String [pk, default: `cuid()`]
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table AuditLog {
  id String [pk, default: `cuid()`]
  barangayId String
  actorId String
  actorRole String
  action String
  entity String
  entityId String
  beforeHash String
  afterHash String
  diff Json
  ip String
  userAgent String
  isAiAction Boolean [default: false]
  createdAt DateTime [default: `now()`]
}

enum ConsentPurpose {
  SERVICE_DELIVERY
  DISBURSEMENT
  BIMS_SHARING
  HEALTH_PROGRAM
  ANALYTICS
}

enum ConsentStatus {
  granted
  withdrawn
  expired
}

Table ConsentRecord {
  id String [pk, default: `cuid()`]
  barangayId String
  householdId String
  inhabitantId String
  purpose ConsentPurpose
  status ConsentStatus [default: 'granted']
  grantedBy String
  grantedAt DateTime [default: `now()`]
  withdrawnAt DateTime
  evidenceUrl String
  notes String
  createdAt DateTime [default: `now()`]
}

enum Sex {
  male
  female
}

enum CivilStatus {
  single
  married
  widowed
  separated
  annulled
}

Table Household {
  id String [pk, default: `cuid()`]
  barangayId String
  householdNo String
  purok String
  sitio String
  houseNo String
  blockNo String
  lotNo String
  street String
  subdivision String
  buildingName String
  addressLine String
  latitude Float
  longitude Float
  squareMeters Float
  hasGarage Boolean [default: false]
  dwellingType String
  roofMaterial String
  wallMaterial String
  tenureStatus String
  landTenure String
  waterSource String
  toiletFacility String
  electricitySource String
  cookingFuel String
  wasteDisposal String
  internetAccess String
  monthlyIncomeBand String
  primaryIncomeSource String
  hazardZoneRisk String
  is4Ps Boolean [default: false]
  isIndigent Boolean [default: false]
  headId String [unique]
  remarks String
  source RecordSource [default: 'CBMS']
  bimsRef String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table Inhabitant {
  id String [pk, default: `cuid()`]
  barangayId String
  householdId String
  relationToHead String
  firstName String
  middleName String
  lastName String
  suffix String
  sex Sex
  birthDate DateTime
  birthPlace String
  civilStatus CivilStatus [default: 'single']
  citizenship String [default: 'Filipino']
  philsysNo String
  contactPhone String
  contactEmail String
  occupation String
  educationLevel String
  religion String
  bloodType String
  monthlyIncome Decimal
  isSenior Boolean [default: false]
  isPwd Boolean [default: false]
  pwdType String
  isSoloParent Boolean [default: false]
  is4Ps Boolean [default: false]
  isIndigenous Boolean [default: false]
  isPregnant Boolean [default: false]
  isBedridden Boolean [default: false]
  isOfw Boolean [default: false]
  isVoter Boolean [default: false]
  isDeceased Boolean [default: false]
  deceasedDate DateTime
  residencyStart DateTime
  isResident Boolean [default: true]
  source RecordSource [default: 'CBMS']
  bimsRef String
  photoUrl String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table ResidencyHistory {
  id String [pk, default: `cuid()`]
  inhabitantId String
  event String
  effectiveAt DateTime
  fromAddress String
  toAddress String
  remarks String
  createdAt DateTime [default: `now()`]
}

enum RequestStatus {
  draft
  submitted
  awaiting_payment
  paid
  for_approval
  approved
  released
  rejected
  cancelled
}

enum PaymentMethod {
  wallet
  otc_cash
  waived
}

Table CertificateType {
  id String [pk, default: `cuid()`]
  barangayId String
  code String
  name String
  description String
  fee Decimal [default: 0]
  validityDays Int [default: 180]
  isActive Boolean [default: true]
  requiresApproval Boolean [default: true]
  requirements String[] [default: '[]']
  exemptNote String
  templateBody String
}

Table CertificateRequest {
  id String [pk, default: `cuid()`]
  barangayId String
  typeId String
  inhabitantId String
  referenceNo String [unique]
  purpose String
  status RequestStatus [default: 'submitted']
  fee Decimal [default: 0]
  paymentMethod PaymentMethod
  paidAt DateTime
  orNumber String
  approvedById String
  approvedAt DateTime
  rejectedReason String
  issuedAt DateTime
  expiresAt DateTime
  verifyCode String [unique]
  pdfUrl String
  submittedAt DateTime [default: `now()`]
  releasedAt DateTime
  processingMs Int
  source RecordSource [default: 'CBMS']
  bimsRef String
  aiDraft String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

enum BlotterCategory {
  dispute
  theft
  physical_injury
  noise
  vandalism
  vawc
  drugs
  traffic
  other
}

Table BlotterEntry {
  id String [pk, default: `cuid()`]
  barangayId String
  entryNo String
  category BlotterCategory [default: 'other']
  incidentAt DateTime
  location String
  narrative String
  reportedBy String
  complainantPhone String
  complainantInhabitantId String
  respondentName String
  isConfidential Boolean [default: false]
  status String [default: 'active'] // active, resolved, endorsed, dismissed
  source RecordSource [default: 'CBMS']
  evidenceUrls String[] [default: '[]']
  recordedById String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

enum KpStage {
  filed
  mediation // Punong Barangay, 15 days
  conciliation // Pangkat, 15 days + 15 extension
  settled
  repudiated
  cfa_issued // Certificate to File Action
  dismissed
  withdrawn
}

Table KpCase {
  id String [pk, default: `cuid()`]
  barangayId String
  caseNo String
  blotterId String [unique]
  subject String
  description String
  stage KpStage [default: 'filed']
  isConfidential Boolean [default: false]
  filedAt DateTime [default: `now()`]
  mediationDueAt DateTime
  conciliationDueAt DateTime
  extendedDueAt DateTime
  closedAt DateTime
  settlementTerms String
  cfaReason String
  pangkatMembers String[] [default: '[]']
  source RecordSource [default: 'CBMS']
  bimsRef String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

enum PartyRole {
  complainant
  respondent
  witness
}

Table KpParty {
  id String [pk, default: `cuid()`]
  caseId String
  role PartyRole
  inhabitantId String
  nameOverride String
  address String
  contact String
}

Table KpHearing {
  id String [pk, default: `cuid()`]
  caseId String
  scheduledAt DateTime
  stage KpStage
  attended Boolean
  minutes String
  outcome String
  createdAt DateTime [default: `now()`]
}

Table KpDocument {
  id String [pk, default: `cuid()`]
  caseId String
  kind String
  pdfUrl String
  issuedAt DateTime [default: `now()`]
}

enum PropertyType {
  infrastructure
  non_infrastructure
}

enum PropertyStatus {
  operational
  under_construction
  unserviceable
  closed
}

Table Property {
  id String [pk, default: `cuid()`]
  barangayId String
  name String
  type PropertyType [default: 'infrastructure']
  status PropertyStatus [default: 'operational']
  category String
  capacity Int [default: 0]
  acquiredAt DateTime
  acquisitionCost Decimal
  custodian String
  description String
  latitude Float
  longitude Float
  addressLine String
  isEvacuationCenter Boolean [default: false]
  source RecordSource [default: 'CBMS']
  bimsRef String
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table MaintenanceRecord {
  id String [pk, default: `cuid()`]
  propertyId String
  performedAt DateTime
  kind String
  cost Decimal
  remarks String
  createdAt DateTime [default: `now()`]
}

Table Material {
  id String [pk, default: `cuid()`]
  barangayId String
  name String
  unit String [default: 'pc']
  quantity Int [default: 0]
  reorderLevel Int [default: 0]
  location String
  updatedAt DateTime
  createdAt DateTime [default: `now()`]
}

Table Hazard {
  id String [pk, default: `cuid()`]
  barangayId String
  purok String
  hazardType String
  riskLevel String
  notes String
  createdAt DateTime [default: `now()`]
}

Table EvacuationCenter {
  id String [pk, default: `cuid()`]
  barangayId String
  propertyId String [unique]
  name String
  capacity Int
  addressLine String
  latitude Float
  longitude Float
  isOpen Boolean [default: false]
  createdAt DateTime [default: `now()`]
}

enum DisasterEventStatus {
  monitoring
  active
  recovery
  closed
}

Table DisasterEvent {
  id String [pk, default: `cuid()`]
  barangayId String
  name String
  hazardType String
  status DisasterEventStatus [default: 'monitoring']
  declaredAt DateTime [default: `now()`]
  closedAt DateTime
  summary String
  createdAt DateTime [default: `now()`]
}

Table EvacuationRecord {
  id String [pk, default: `cuid()`]
  eventId String
  centerId String
  householdId String
  headcount Int [default: 1]
  checkInAt DateTime [default: `now()`]
  checkOutAt DateTime
}

Table ReliefDistribution {
  id String [pk, default: `cuid()`]
  eventId String
  householdId String
  goods String
  quantity Int [default: 1]
  cashAmount Decimal
  releasedAt DateTime [default: `now()`]
  releasedBy String
  receivedBy String
}

Table GadPlan {
  id String [pk, default: `cuid()`]
  barangayId String
  year Int
  totalBudget Decimal
  gadBudget Decimal
  status String [default: 'draft']
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

Table GadActivity {
  id String [pk, default: `cuid()`]
  planId String
  title String
  attribution String
  genderIssue String
  budget Decimal
  actualSpend Decimal
  targetOutput String
  actualOutput String
  quarter Int
  status String [default: 'planned']
}

enum LegislationKind {
  ordinance
  resolution
  executive_order
}

enum LegislationStatus {
  draft
  enacted
  vetoed
  amended
  repealed
}

Table Legislation {
  id String [pk, default: `cuid()`]
  barangayId String
