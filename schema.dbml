enum WalletOwnerType {
  resident
  official
  treasury
  merchant
  agent
}

enum KycTier {
  tier1 // single ID / PhilSys, low limits
  tier2 // full KYC
}

enum WalletStatus {
  active
  frozen
  closed
}

Table Wallet {
  id String [pk, default: `cuid()`]
  barangayId String
  ownerType WalletOwnerType
  inhabitantId String [unique]
  emiAccountRef String [unique]
  kycTier KycTier [default: 'tier1']
  status WalletStatus [default: 'active']
  balanceCentavos BigInt [default: 0]
  createdAt DateTime [default: `now()`]
  updatedAt DateTime
}

enum TxnType {
  disbursement
  fee_collection
  bill_payment
  merchant_payment
  p2p_transfer
  cash_in
  cash_out
  reversal
  adjustment
}

enum TxnStatus {
  pending
  completed
  failed
  reversed
}

Table WalletTransaction {
  id String [pk, default: `cuid()`]
  barangayId String
  type TxnType
  status TxnStatus [default: 'pending']
  fromWalletId String
  toWalletId String
  amountCentavos BigInt
  feeCentavos BigInt [default: 0]
  currency String [default: 'PHP']
  reference String [unique]
  description String
  emiTxnRef String
  batchItemId String [unique]
  certificateRequestId String
  billPaymentId String [unique]
  agentId String
  merchantId String
  completedAt DateTime
  createdAt DateTime [default: `now()`]
}

enum BatchStatus {
  draft
  for_approval
  approved
  executing
  completed
  failed
  cancelled
}

enum BatchKind {
  payroll_honoraria
  allowance_stipend
  ayuda_social
}

Table DisbursementBatch {
  id String [pk, default: `cuid()`]
  barangayId String
  batchNo String
