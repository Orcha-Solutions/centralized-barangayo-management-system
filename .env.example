# Database is run entirely in-memory using seed.json mock database. No Postgres required.

# ---- API ----
API_PORT=4000
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- Auth ----
JWT_SECRET="dev-only-change-me-in-production-please-32chars-min"
JWT_EXPIRES_IN="8h"
# Field-level encryption key for sensitive columns (KP/VAWC narratives, health notes).
# 32-byte key, base64. Generate: openssl rand -base64 32
FIELD_ENCRYPTION_KEY="ZGV2LW9ubHkta2V5LTMyLWJ5dGVzLWxvbmctcGFkZGVkIQ=="

# ---- AI layer (packages/ai) ----
# Provider: anthropic | openai | gemini | mock
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
AI_MODEL_COMPLEX="claude-opus-4-8"
AI_MODEL_FAST="claude-haiku-4-5-20251001"

# ---- Storage (MinIO in dev) ----
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="cbms"
S3_ACCESS_KEY="cbms"
S3_SECRET_KEY="cbms_dev_password"

# ---- Email (MailHog in dev) ----
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="no-reply@cbms.local"

# ---- SMS (mock; SMS is OTP + critical alerts only, never bulk notifications) ----
SMS_PROVIDER="console"

# ---- Feature defaults ----
DEFAULT_TENANT_MODE="companion"
